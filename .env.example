# Публичный URL сайта (canonical, sitemap, OG). Без порта 443 для HTTPS.
# На Railway НЕ подставляйте PORT (8080 и т.д.) — только внешний домен, например https://dordoi.help
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Поисковики: пока не задано — сайт с noindex и Disallow в robots.txt. Для продакшена: true
# NEXT_PUBLIC_SITE_INDEXABLE=true

# Supabase (Settings → API): Project URL + publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Секрет OpenAI — только для offline-скриптов (не коммитить реальное значение)
OPENAI_API_KEY=

OPENAI_DESIGN_MODEL=gpt-5.5-pro
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Telegram-бот онбординга продавцов (Python, см. bot/requirements.txt)
# Токен от @BotFather; URL проекта как в NEXT_PUBLIC_SUPABASE_URL; ключ service_role (только сервер, не в браузер)
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_TELEGRAM_IDS=

# Ссылка для продавца после онбординга (если не задано — NEXT_PUBLIC_APP_URL + /login)
# VENDOR_LOGIN_URL=https://dordoi.help/ru/login

# Куда отправлять полную копию заявки (username или id). По умолчанию @loomany
# ADMIN_NOTIFY_CHAT=@loomany

# GREEN-API (WhatsApp): параметры инстанса из https://console.green-api.com
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# JWT для шага регистрации после OTP (случайная строка ≥16 символов, только сервер).
# Обязательно для первого входа по новому номеру (иначе после верного кода будет ошибка).
AUTH_REGISTRATION_SECRET=

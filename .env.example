# Публичный URL сайта (canonical, sitemap, OG). Без порта 443 для HTTPS.
# На Railway НЕ подставляйте PORT (8080 и т.д.) — только внешний домен, например https://dordoi.help
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Поисковики: пока не задано — сайт с noindex и Disallow в robots.txt. Для продакшена: true
# NEXT_PUBLIC_SITE_INDEXABLE=true

# Supabase (Settings → API): Project URL + publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Секрет OpenAI — только для offline-скриптов (не коммитить реальное значение)
OPENAI_API_KEY=

OPENAI_DESIGN_MODEL=gpt-5.5-pro
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

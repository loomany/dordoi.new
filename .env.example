# Публичный URL сайта (canonical, sitemap, OG). Нужен и боту онбординга продавца для ссылки «Открыть кабинет».
# Без порта 443 для HTTPS. На Railway — только внешний домен, например https://dordoi.help (не PORT контейнера).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Поисковики: пока не задано — сайт с noindex и Disallow в robots.txt. Для продакшена: true
# Выставить до сборки на CI (Railway): NEXT_PUBLIC_* подставляется при next build.
# `app/robots.ts` и `app/sitemap.ts` с force-dynamic читают значение и при runtime после деплоя.
# NEXT_PUBLIC_SITE_INDEXABLE=true

# Supabase (Settings → API): Project URL + publishable (anon) key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Секрет OpenAI — только для offline-скриптов (не коммитить реальное значение)
OPENAI_API_KEY=

# Восстановить только ссылки на уже залитые фото в БД (без fal, без GPT):
#   npm run seed:showcase-restore-media
#
# fal.ai — для полного `npm run seed:showcase-ai` и --images-only ключ обязателен
# https://fal.ai/dashboard
# FAL_KEY=
# FAL_IMAGE_MODEL=fal-ai/nano-banana-2
# FAL_IMAGE_RESOLUTION=1K
# FAL_SAFETY_TOLERANCE=5
# FAL_OUTPUT_FORMAT=jpeg

OPENAI_DESIGN_MODEL=gpt-5.5-pro
OPENAI_TRANSLATION_MODEL=gpt-4o-mini

# Telegram-бот онбординга продавцов (Python, см. bot/requirements.txt). Тот же токен на сервере Next.js —
# уведомление продавцу в Telegram после одобрения анкеты (ссылка на каталог).
# Токен от @BotFather; URL проекта как в NEXT_PUBLIC_SUPABASE_URL; ключ service_role (только сервер, не в браузер)
TELEGRAM_BOT_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Через запятую: numeric Telegram user id админов (дублирующие уведомления ботом при /start и при отправке анкеты).
ADMIN_TELEGRAM_IDS=
# Альтернативное имя (Railway и др.), то же значение — через запятую numeric id
# TELEGRAM_ADMIN_IDS=

# Бот анкеты продавца: главная «Добавить точку», блок ролей «Я продавец», страница /sell. Username или полный https://t.me/…
# NEXT_PUBLIC_TELEGRAM_VENDOR_BOT=dordoi_help_admin_bot

# E2E: полный проход анкеты от имени пользователя (scripts/e2e_vendor_onboarding_telethon.py)
# Ключи с https://my.telegram.org — это НЕ токен бота.
# TELEGRAM_API_ID=
# TELEGRAM_API_HASH=
# E2E_VENDOR_BOT_USERNAME=
# E2E_PHONE=+996555000000
# Опционально: своё имя витрины и файл сессии Telethon
# E2E_STORE_NAME=[E2E] Мой тест
# E2E_TELEGRAM_SESSION=scripts/.e2e_telegram.session

# Явная ссылка на вход продавца (если не задано — NEXT_PUBLIC_APP_URL + /login). Для локали: …/ru/login
# VENDOR_LOGIN_URL=https://dordoi.help/ru/login

# Куда бот шлёт служебные уведомления: /start новой анкеты и полностью заполненная заявка (HTML).
# Числовой id или @username. Если не задано — только в личку по ADMIN_TELEGRAM_IDS / TELEGRAM_ADMIN_IDS.
# ADMIN_NOTIFY_CHAT=123456789
# ADMIN_NOTIFY_CHAT=@your_admin_username

# GREEN-API (WhatsApp): параметры инстанса из https://console.green-api.com
GREEN_API_URL=https://api.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# JWT для шага регистрации после OTP (случайная строка ≥16 символов, только сервер).
# Обязательно для первого входа по новому номеру (иначе после верного кода будет ошибка).
AUTH_REGISTRATION_SECRET=
